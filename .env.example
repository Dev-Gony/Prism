# Prism local environment template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real secret.

# Gemini - server only
GEMINI_API_KEY=

# Supabase - public project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for future server-side Supabase operations.
# Leave empty until a server-only feature explicitly needs it.
SUPABASE_SECRET_KEY=
