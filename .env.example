# Prism local environment template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real secret.

# Gemini - server only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# App URL - set to the stable production URL on Vercel
NEXT_PUBLIC_SITE_URL=

# Supabase - public project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server only; never expose this value to the browser
SUPABASE_SECRET_KEY=

# Vercel Cron - server only; use a long random value
CRON_SECRET=

# Web Push - public key may be sent to the browser; private key stays server-only
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://prism-nine-livid.vercel.app
